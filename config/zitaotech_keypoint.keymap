#include <dt-bindings/zmk/mouse.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define LOWER 1
#define RAISE 2
#define MOUSE 3
#define BOT bootloader

/ {
    behaviors {
        td0: tap_dance_0 {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp LCLK>, <&bt BT_CLR>;
        };
    };

    behaviors {
        tdRMCLK: tap_dance_R_LMouse {
            compatible = "zmk,behavior-tap-dance";
            #binding-cells = <0>;
            tapping-term-ms = <400>;
            bindings = <&mkp RCLK>, <&mkp MCLK>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <500>;
            bindings = <&kp &kp>;
        };
    };

    behaviors {
        LMouse_sc: behavior_LMouse_Scroll {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&none &mkp>;        /* hold=none, tap=Lmouse */
        };
    };

    behaviors {
        M_kp: behavior_mouse_keypress {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";     /* 单击优先 */
            tapping-term-ms = <200>;       /* 长按阈值 */
            bindings = <&mkp &kp>;        /* hold=mou key press, tap=key*/
        };
    };

    behaviors {
        BLE_encoder: BLE_encoder {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&bt BT_NXT>, <&bt BT_PRV>;
        };
    };

    macros {
        javascript_arrow: javascript_arrow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp EQUAL &kp GREATER_THAN>;
            label = "JAVASCRIPT_ARROW";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        QWERTY {
            display-name = "QWERTY";
            bindings = <
&kp ESC           &kp Q         &kp W             &kp E  &kp R  &kp T                   &kp Y      &kp U      &kp I           &kp O          &kp P  &kp BSPC
&kp LEFT_COMMAND  &kp A         &kp S             &kp D  &kp F  &kp G                   &mkp LCLK  &mkp LCLK  &kp H           &kp J          &kp K  &kp L      &kp SINGLE_QUOTE  &kp ENTER
&kp LSHFT         &kp Z         &kp X             &kp C  &kp V  &kp B                   &kp PG_DN  &kp PG_UP  &msc SCRL_DOWN  &msc SCRL_UP   &kp N  &kp M      &kp COMMA         &kp DOT    &kp FSLH  &kp RSHFT
&kp LEFT_COMMAND  &kp LEFT_ALT  &kp LEFT_CONTROL  &to 2  &mo 2  &mt LEFT_ALT SEMICOLON  &mo 1      &kp SPACE  &kp COLON       &kp RIGHT_ALT  &to 4  &kp MINUS  &kp EQUAL         &kp GRAVE
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN_ARROW>,
                <&inc_dec_kp K_SCROLL_UP K_SCROLL_DOWN>;
        };

        NUM_FN {
            display-name = "NUM_FN";
            bindings = <
&kp TAB           &kp N1    &kp N2  &kp N3      &kp N4   &kp N5     &kp N6     &kp N7           &kp N8             &kp N9         &kp N0        &kp GRAVE
&kp LEFT_COMMAND  &kp F1    &kp F2  &kp F3      &kp F4   &kp F5     &mkp RCLK  &mkp RCLK        &kp F6             &kp MINUS      &kp EQUAL     &kp LEFT_BRACKET  &kp RIGHT_BRACKET  &kp BACKSLASH
&none             &kp F7    &kp F8  &kp F9      &kp F10  &kp F11    &trans     &trans           &bl BL_DEC         &bl BL_INC     &kp F12       &kp DELETE        &kp COMMA          &kp DOT        &kp SLASH  &trans
&none             &kp LGUI  &none   &bt BT_CLR  &none    &kp SPACE  &mo 1      &kp RIGHT_SHIFT  &javascript_arrow  &kp RIGHT_ALT  &out OUT_TOG  &trans            &trans             &kp CAPS
            >;

            sensor-bindings =
                <&inc_dec_kp UP_ARROW DOWN>,
                <&inc_dec_kp LEFT RIGHT>;
        };

        ARROW_BT {
            display-name = "ARROW_BT";
            bindings = <
&none  &none     &kp UP    &none      &none  &none  &none  &trans  &trans      &none       &none         &kp BACKSPACE
&none  &kp LEFT  &kp DOWN  &kp RIGHT  &none  &none  &none  &none   &bt BT_NXT  &bt BT_PRV  &bt BT_CLR    &bt BT_CLR_ALL  &none         &kp RETURN
&none  &none     &none     &none      &none  &none  &none  &none   &none       &none       &bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &none  &none
&none  &none     &none     &to 2      &none  &none  &none  &none   &none       &none       &to 0         &none           &none         &none
            >;
        };

        MOUSE_layer {
            display-name = "MOUSE";
            bindings = <
&kp TAB    &kp Q     &kp W     &kp E  &kp R  &kp T      &kp Y           &M_kp MB3 U       &kp I     &kp O        &kp P       &kp BSPC
&kp CAPS   &kp A     &kp S     &kp D  &kp F  &kp G      &mkp LCLK       &mkp LCLK         &kp H     &M_kp MB1 J  &kp K       &kp L        &kp SEMI   &kp ENTER
&kp LSHFT  &kp Z     &kp X     &kp C  &kp V  &kp B      &msc SCRL_DOWN  &msc SCRL_UP      &none     &none        &kp N       &M_kp MB2 M  &kp COMMA  &kp DOT    &kp FSLH  &kp RSHFT
&kp LCTRL  &kp LGUI  &kp LALT  &none  &mo 2  &kp SPACE  &mkp MB1        &LMouse_sc 0 MB1  &tdRMCLK  &mo 2        &kp C_MUTE  &kp MINUS    &kp EQUAL  &kp GRAVE
            >;
        };

        NUMPAD {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans  &kp KP_MULTIPLY  &kp KP_NUMBER_7  &kp KP_NUMBER_8  &kp KP_NUMBER_9  &kp KP_SUBTRACT  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &kp KP_DIVIDE    &kp KP_NUMBER_4  &kp KP_NUMBER_5  &kp KP_NUMBER_6  &kp KP_PLUS      &kp RETURN
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &trans           &trans           &trans           &kp KP_NUMBER_1  &kp KP_NUMBER_2  &kp KP_NUMBER_3  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans           &trans           &trans           &kp KP_NUMBER_0  &to 0            &kp KP_DOT       &trans           &trans
            >;
        };
    };
};
